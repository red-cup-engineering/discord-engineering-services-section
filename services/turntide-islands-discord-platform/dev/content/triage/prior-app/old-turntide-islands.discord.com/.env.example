# Discord bot application
DISCORD_SERVER_NAME=Turntide Islands
DISCORD_BOT_NAME=Tidewatcher
DISCORD_ADMIN=emsenn
DISCORD_CLIENT_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_CHANNEL_ID=
DISCORD_ADMIN_USER_ID=

# OpenAI-compatible inference endpoint
TTI_AGENT_ENDPOINT=nvidia
NVIDIA_API_KEY=
# TTI_AGENT_MODEL=meta/llama-3.1-8b-instruct

# Agent memory and context
# TTI_AGENT_DATA_ROOT=./data/agent
TTI_CONTEXT_BUDGET=1800
TTI_GATE_MODE=off
# Optional cost projection for live pulse logs
# TTI_COST_DOLLARS_PER_MILLION_INPUT_TOKENS=
# TTI_COST_DOLLARS_PER_MILLION_OUTPUT_TOKENS=
# TTI_COST_CHARS_PER_TOKEN=4

# Membership and fulfillment
TURNTIDE_ISLANDER_ROLE_ID=
TTI_MEMBERSHIP_ENTITLEMENTS_FILE=
