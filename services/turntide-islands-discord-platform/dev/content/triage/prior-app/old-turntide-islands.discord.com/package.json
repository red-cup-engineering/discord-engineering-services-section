{
  "name": "@causeway-services/turntide-islands-discord-com",
  "version": "0.0.1",
  "type": "module",
  "keywords": [
    "decommissioned",
    "triage"
  ],
  "description": "Turntide Islands Discord site and archive, downstream of @emsenn/organizing-with-discord.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "serve": "node src/serve.mjs",
    "steward:check": "node src/steward.mjs check",
    "steward:discover-env": "node src/steward.mjs discover-env",
    "steward:live-permissions": "node src/steward.mjs live-permissions",
    "steward:measure": "node src/steward.mjs measure",
    "steward:ingest-history": "node src/ingest-history.mjs",
    "steward:ingest-history:smoke": "node src/steward.mjs ingest-history-smoke",
    "steward:invite": "node src/steward.mjs invite",
    "steward:bootstrap": "node src/steward.mjs bootstrap",
    "steward:bootstrap:smoke": "node src/steward.mjs bootstrap-smoke",
    "steward:preflight": "node src/steward.mjs preflight",
    "steward:probe": "node src/steward.mjs probe",
    "steward:smoke": "node src/steward.mjs smoke",
    "steward:context:smoke": "node src/steward.mjs context-smoke",
    "steward:gateway:smoke": "node src/steward.mjs gateway-smoke",
    "steward:supervision:smoke": "node src/steward.mjs supervision-smoke",
    "steward:archipelago:smoke": "node src/steward.mjs archipelago-smoke",
    "steward:membership:reconcile": "node src/steward.mjs membership-reconcile",
    "steward:membership:reconcile:smoke": "node src/steward.mjs membership-reconcile-smoke",
    "steward:membership:service:smoke": "node src/steward.mjs membership-service-smoke",
    "steward:cultivate": "node src/steward.mjs cultivate",
    "steward:cultivate:smoke": "node src/steward.mjs cultivate-smoke",
    "steward:run": "node src/steward.mjs run"
  },
  "bin": {
    "turntide-capital-measurement": "./scripts/capital-measurement.mjs",
    "turntide-membership": "./scripts/membership.mjs",
    "turntide-orchestration": "./scripts/orchestration.mjs",
    "turntide-summary": "./scripts/summary.mjs",
    "turntide-vault": "./scripts/vault.mjs"
  },
  "x-jsnode-bin-transport": {
    "protocol": "stdio-json",
    "input": "application/json",
    "output": "application/json"
  },
  "x-jsnode-bin": {
    "turntide-capital-measurement": {
      "summary": "Read the Turntide Islands Discord capital-measurement carrier.",
      "description": "Projects the durable/trapped capital and enclosure criteria used by the Turntide Islands steward.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    "turntide-membership": {
      "summary": "Read the Turntide Islands membership carrier.",
      "description": "Projects the paid membership program, rendered membership system, and unresolved environment references.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    "turntide-orchestration": {
      "summary": "Read the Turntide Islands orchestration carrier.",
      "description": "Projects the Discord orchestration profile, rendered agent system, lanes, roles, and source streams.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    "turntide-summary": {
      "summary": "Read the Turntide Islands site summary carrier.",
      "description": "Projects the site summary derived from organizing-with-discord and organizing-a-knowledge-vault carriers.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    "turntide-vault": {
      "summary": "Read the Turntide Islands vault carrier.",
      "description": "Projects the knowledge-vault rigging, climate-breakdown document sample, and rendered vault system prompt.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  },
  "exports": {
    ".": "./src/index.mjs",
    "./serve": "./src/serve.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/app-discord-steward": "0.0.0",
    "@red-cup-engineering/http-server": "0.0.0",
    "@emsenn/jsnode-ick": "0.0.0",
    "@emsenn/organizing-a-knowledge-vault": "0.0.0",
    "@emsenn/organizing-with-agents": "0.0.0",
    "@emsenn/organizing-with-discord": "0.0.0",
    "@emsenn/organizing-with-openai-agents": "0.0.0"
  },
  "sideEffects": false
}
