{
  "name": "@emsenn/organizing-with-discord",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Organizing with Discord - agentic operation of a Discord server by any OpenAI-compatible endpoint, with JSON-Schema carriers, relational IR identity actions, a pure Discord operation vocabulary, transport/gateway boundaries, and autonomous server tending.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/scripts/organizer.mjs dist/scripts/operations.mjs",
    "test": "pnpm run rebuild && node --test test/*.test.mjs",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "bin": {
    "discord-organizer": "./dist/scripts/organizer.mjs",
    "discord-organizer-ops": "./dist/scripts/operations.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./holography": {
      "types": "./dist/holography.d.mts",
      "import": "./dist/holography.mjs"
    },
    "./transport": {
      "types": "./dist/transport.d.mts",
      "import": "./dist/transport.mjs"
    },
    "./gateway": {
      "types": "./dist/gateway.d.mts",
      "import": "./dist/gateway.mjs"
    },
    "./operations": {
      "types": "./dist/operations.d.mts",
      "import": "./dist/operations.mjs"
    },
    "./algebra": {
      "types": "./dist/algebra/index.d.mts",
      "import": "./dist/algebra/index.mjs"
    },
    "./context": {
      "types": "./dist/context.d.mts",
      "import": "./dist/context.mjs"
    },
    "./capital": {
      "types": "./dist/capital.d.mts",
      "import": "./dist/capital.mjs"
    },
    "./witnessing": {
      "types": "./dist/witnessing.d.mts",
      "import": "./dist/witnessing.mjs"
    },
    "./enclosure": {
      "types": "./dist/enclosure.d.mts",
      "import": "./dist/enclosure.mjs"
    },
    "./policy": {
      "types": "./dist/policy.d.mts",
      "import": "./dist/policy.mjs"
    },
    "./dispatch": {
      "types": "./dist/dispatch.d.mts",
      "import": "./dist/dispatch.mjs"
    },
    "./topology": {
      "types": "./dist/topology.d.mts",
      "import": "./dist/topology.mjs"
    },
    "./loop": {
      "types": "./dist/loop.d.mts",
      "import": "./dist/loop.mjs"
    },
    "./tending": {
      "types": "./dist/tending.d.mts",
      "import": "./dist/tending.mjs"
    },
    "./orchestration": {
      "types": "./dist/orchestration.d.mts",
      "import": "./dist/orchestration.mjs"
    },
    "./membership": {
      "types": "./dist/membership.d.mts",
      "import": "./dist/membership.mjs"
    },
    "./scripts/organizer": {
      "types": "./dist/scripts/organizer.d.mts",
      "import": "./dist/scripts/organizer.mjs"
    },
    "./scripts/operations": {
      "types": "./dist/scripts/operations.d.mts",
      "import": "./dist/scripts/operations.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/animating": "workspace:*",
    "@emsenn/organizing-with-agents": "workspace:*",
    "@emsenn/organizing-with-llm-agents": "workspace:*",
    "@emsenn/organizing-with-openai-agents": "workspace:*",
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false,
  "keywords": [
    "decommissioned"
  ]
}
