function bad(message:string):never{throw new TypeError(message);}
function makeJournal(revision:number,entries:readonly ResponseReceipt[]):Journal {const base={type:"ZeloProgrammableResponseReceiptJournal" as const,version:1 as const,revision,entries};return frozen({...base,digest:hash(base)});}
function parseJournal(value:unknown):Journal {if(!value||typeof value!=="object"||Array.isArray(value))throw new TypeError("receipt journal invalid");const j=value as Record<string,unknown>;if(!keys(j,["digest","entries","revision","type","version"])||j.type!=="ZeloProgrammableResponseReceiptJournal"||j.version!==1||!Number.isSafeInteger(j.revision)||(j.revision as number)<0||!Array.isArray(j.entries))throw new TypeError("receipt journal schema invalid");const entries=j.entries.map(parseReceipt);if(new Set(entries.map(x=>x.id)).size!==entries.length||j.digest!==hash({type:j.type,version:j.version,revision:j.revision,entries}))throw new TypeError("receipt journal digest invalid");return makeJournal(j.revision as number,entries);}
async function load(file:string):Promise<Journal>{try{return parseJournal(JSON.parse(await readFile(file,"utf8")));}catch(e:unknown){if((e as {code?:string}).code==="ENOENT")return makeJournal(0,[]);throw e;}}
async function save(file:string,next:Journal):Promise<void>{const dir=path.dirname(file);await mkdir(dir,{recursive:true,mode:0o700});await chmod(dir,0o700);const temporary=`${file}.tmp-${process.pid}-${randomUUID()}`;const handle=await open(temporary,"wx",0o600);try{await handle.writeFile(`${canonical(next)}\n`);await handle.chmod(0o600);await handle.sync();}finally{await handle.close();}await rename(temporary,file);const journalHandle=await open(file,"r+");try{await journalHandle.chmod(0o600);await journalHandle.sync();}finally{await journalHandle.close();}const d=await open(dir,"r");try{await d.sync();}finally{await d.close();}}
async function transition(file:string,current:Journal,entries:readonly ResponseReceipt[]):Promise<Journal>{const next=makeJournal(current.revision+1,entries);await save(file,next);return next;}
async function serialized<T>(file:string,fn:()=>Promise<T>):Promise<T>{const prior=locks.get(file)??Promise.resolve();let release!:()=>void;const mine=new Promise<void>(r=>{release=r;});const chain=prior.then(()=>mine);locks.set(file,chain);await prior;try{return await fn();}finally{release();if(locks.get(file)===chain)locks.delete(file);}}
export async function readResponseReceipts(file:string):Promise<readonly ResponseReceipt[]>{return (await load(file)).entries;}
export function parseZeloProgrammableResponseDeliveryConfig(value:unknown):ZeloProgrammableResponseDeliveryConfig {if(!value||typeof value!=="object"||Array.isArray(value))throw new TypeError("delivery config must be object");const v=value as Record<string,unknown>;if(!keys(v,["allowedScopeIds","guildId","maxStateAgeMs","mode","program","type","version"])||v.type!=="ZeloProgrammableResponseDeliveryConfig"||v.version!==1||(v.mode!=="disabled"&&v.mode!=="programmable-response-delivery")||!Array.isArray(v.allowedScopeIds)||!Number.isSafeInteger(v.maxStateAgeMs)||(v.maxStateAgeMs as number)<1||(v.maxStateAgeMs as number)>300000)throw new TypeError("delivery config invalid");const normalized=normalizeCommunityResponseProgram(v.program as Parameters<typeof normalizeCommunityResponseProgram>[0]);if(normalized.commands.some(c=>c.variables.length!==0))throw new TypeError("active delivery rejects program variables");const program:CommunityResponseProgramInput={...normalized,commands:normalized.commands.map(command=>({...command,triggers:command.triggers.map(trigger=>({kind:"exact-text" as const,value:trigger}))}))};const allowedScopeIds=v.allowedScopeIds.map(x=>typeof x==="string"&&/^discord-channel:[0-9]{17,20}$/u.test(x)?x:bad("scope must name allowed channel"));if(!allowedScopeIds.length||new Set(allowedScopeIds).size!==allowedScopeIds.length)throw new TypeError("allowed scopes invalid");return frozen({type:"ZeloProgrammableResponseDeliveryConfig",version:1,mode:v.mode,guildId:snowflake(v.guildId,"guildId"),program,allowedScopeIds,maxStateAgeMs:v.maxStateAgeMs as number});}
const observed=(x:ResponseRateState):CommunityResponseRateBudgetObservation=>({type:"CommunityResponseRateBudgetObservation",version:1,...x});
const fail=(x:ResponseReceipt,code:ResponseReceiptError):ResponseReceipt=>{const {receiptDigest:_digest,messageId:_message,...base}=x;return receipt({...base,status:code==="manual-recovery-required"?"recovery-required":"failed",errorCode:code});};
export async function deliverProgrammableResponse(input:{readonly config:ZeloProgrammableResponseDeliveryConfig;readonly lease:ZeloLease;readonly event:CommunityResponseEvent;readonly eventGuildId:string;readonly rateState:ResponseRateState;readonly variables:Record<string,never>;readonly receiptFile:string;readonly transport:ResponseSendTransport;readonly recheck:()=>Promise<ResponseRateState>;readonly now:Date;}):Promise<ResponseReceipt|undefined>{if(input.config.mode==="disabled")return undefined;if(!hasActiveZeloLease(input.lease))throw new TypeError("issued active process lease required");if(!input.transport.authenticated||snowflake(input.eventGuildId,"event guild")!==input.config.guildId||!input.config.allowedScopeIds.includes(input.event.scopeId)||input.event.originResponse)throw new TypeError("unauthorized guild, transport, scope, or bot-origin event");const channelId=snowflake(input.event.scopeId.replace(/^discord-channel:/u,""),"channelId");const plan=planCommunityResponse(input.config.program as unknown as Parameters<typeof planCommunityResponse>[0],input.event,{now:input.now,maxObservationAgeMs:input.config.maxStateAgeMs,variables:input.variables,rateBudgetObservation:observed(input.rateState)});if(plan.kind!=="propose"||plan.proposal.visibility!=="public")return undefined;const common={guildId:input.config.guildId,channelId,proposalId:plan.proposal.id,programRevision:input.config.program.revision,programDigest:hash(input.config.program),eventDigest:hash(input.event),rateStateDigest:hash(input.rateState)};const id=`zelo-program-response:${hash(common)}`,reserved=receipt({...common,type:"ZeloProgrammableResponseReceipt",version:1,id,requestDigest:hash({id,channelId,content:plan.proposal.content,allowed_mentions:{parse:[]}}),status:"reserved"});return serialized(input.receiptFile,async()=>{let current=await load(input.receiptFile);const prior=current.entries.find(x=>x.id===id);if(prior)return prior;current=await transition(input.receiptFile,current,[...cur