export type ZeloProgrammableResponseMode = "disabled" | "programmable-response-delivery";
export interface ZeloProgrammableResponseDeliveryConfig { readonly type:"ZeloProgrammableResponseDeliveryConfig"; readonly version:1; readonly mode:ZeloProgrammableResponseMode; readonly guildId:string; readonly program:CommunityResponseProgramInput; readonly allowedScopeIds:readonly string[]; readonly maxStateAgeMs:number; }
export interface ResponseRateState { readonly observedAt:string; readonly sourceRevision:string; readonly commandId:string; readonly scopeId:string; readonly window:string; readonly responseCount:number; }
export interface ResponseSendTransport { readonly authenticated:true; send(input:{readonly channelId:string;readonly content:string;readonly idempotencyKey:string;readonly allowed_mentions:{readonly parse:readonly []}}):Promise<{readonly messageId:string}>; delete(input:{readonly channelId:string;readonly messageId:string;readonly idempotencyKey:string}):Promise<void>; }
export type ResponseReceiptStatus="reserved"|"applied"|"failed"|"recovery-required"|"rollback-failed"|"rolled-back";
export type ResponseReceiptError="recheck-changed"|"send-failed"|"delete-failed"|"manual-recovery-required";
export interface ResponseReceipt { readonly type:"ZeloProgrammableResponseReceipt";readonly version:1;readonly id:string;readonly guildId:string;readonly channelId:string;readonly proposalId:string;readonly programRevision:string;readonly programDigest:string;readonly eventDigest:string;readonly rateStateDigest:string;readonly requestDigest:string;readonly status:ResponseReceiptStatus;readonly messageId?:string;readonly errorCode?:ResponseReceiptError;readonly receiptDigest:string; }
interface Journal { readonly type:"ZeloProgrammableResponseReceiptJournal";readonly version:1;readonly revision:number;readonly entries:readonly ResponseReceipt[];readonly digest:string; }
const locks=new Map<string,Promise<void>>();
const canonical=(v:unknown):string=>v===null||typeof v!=="object"?JSON.stringify(v):Array.isArray(v)?`[${v.map(canonical).join(",")}]`:`{${Object.keys(v as Record<string,unknown>).sort().map(k=>`${JSON.stringify(k)}:${canonical((v as Record<string,unknown>)[k])}`).join(",")}}`;
const hash=(v:unknown)=>createHash("sha256").update(canonical(v)).digest("hex");
const keys=(v:Record<string,unknown>, expected:readonly string[])=>{const actual=Object.keys(v).sort();return actual.length===expected.length&&actual.every((x,i)=>x===expected[i]);};
const snowflake=(v:unknown,n:string):string=>{if(typeof v!=="string"||!/^[0-9]{17,20}$/u.test(v))throw new TypeError(`${n} must be a Discord snowflake`);return v;};
const digest=(v:unknown,n:string):string=>{if(typeof v!=="string"||!/^[a-f0-9]{64}$/u.test(v))throw new TypeError(`${n} invalid`);return v;};
const frozen=<T,>(v:T):Readonly<T>=>Object.freeze(structuredClone(v));
function receipt(v:Omit<ResponseReceipt,"receiptDigest">):ResponseReceipt{return frozen({...v,receiptDigest:hash(v)});}
function parseReceipt(value:unknown):ResponseReceipt {
  if(!value||typeof value!=="object"||Array.isArray(value))throw new TypeError("receipt must be object");const r=value as Record<string,unknown>;
  const status=r.status;const expected=status==="reserved"?["channelId","eventDigest","guildId","id","programDigest","programRevision","proposalId","rateStateDigest","receiptDigest","requestDigest","status","type","version"]:status==="applied"||status==="rolled-back"?["channelId","eventDigest","guildId","id","messageId","programDigest","programRevision","proposalId","rateStateDigest","receiptDigest","requestDigest","status","type","version"]:status==="rollback-failed"?["channelId","errorCode","eventDigest","guildId","id","messageId","programDigest","programRevision","proposalId","rateStateDigest","receiptDigest","requestDigest","status","type","version"]:["channelId","errorCode","eventDigest","guildId","id","programDigest","programRevision","proposalId","rateStateDigest","receiptDigest","requestDigest","status","type","version"];
