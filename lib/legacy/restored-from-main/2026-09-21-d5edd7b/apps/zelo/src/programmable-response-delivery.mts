/** After a crash with a durable reservation, do not resend; make recovery an explicit operator record. */
export async function markReservedProgrammableResponseForManualRecovery(receiptInput:ResponseReceipt,lease:ZeloLease,file:string):Promise<ResponseReceipt>{if(!hasActiveZeloLease(lease))throw new TypeError("issued active process lease required");const admitted=parseReceipt(receiptInput);return serialized(file,async()=>{const current=await load(file),stored=current.entries.find(x=>x.id===admitted.id);if(!stored||canonical(stored)!==canonical(admitted))throw new TypeError("receipt does not match journal");if(stored.status!=="reserved")return stored;const next=fail(stored,"manual-recovery-required");await transition(file,current,[...current.entries.filter(x=>x.id!==stored.id),next]);return next;});}
export async function rollbackProgrammableResponse(receiptInput:ResponseReceipt,lease:ZeloLease,transport:ResponseSendTransport,file:string):Promise<ResponseReceipt>{if(!hasActiveZeloLease(lease)||!transport.authenticated)throw new TypeError("issued active lease and authenticated transport required");const admitted=parseReceipt(receiptInput);return serialized(file,async()=>{const current=await load(file),stored=current.entries.find(x=>x.id===admitted.id);if(!stored||canonical(stored)!==canonical(admitted))throw new TypeError("receipt does not match journal");if(stored.status==="rolled-back")return stored;if((stored.status!=="applied"&&stored.status!=="rollback-failed")||!stored.messageId)throw new TypeError("only an applied response can roll back");try{await transport.delete({channelId:stored.channelId,messageId:stored.messageId,idempotencyKey:`${stored.id}:rollback`});}catch{const {receiptDigest:_digest,errorCode:_error,...base}=stored;const next=receipt({...base,status:"rollback-failed",errorCode:"delete-failed"});await transition(file,current,[...current.entries.filter(x=>x.id!==stored.id),next]);return next;}const {receiptDigest:_digest,errorCode:_error,...base}=stored;const next=receipt({...base,status:"rolled-back"});await transition(file,current,[...current.entries.filter(x=>x.id!==stored.id),next]);return next;});}
