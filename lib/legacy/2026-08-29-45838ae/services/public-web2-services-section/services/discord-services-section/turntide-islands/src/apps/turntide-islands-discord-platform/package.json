      "types": "./src/turntide-software-system/serve.mts",
      "import": "./src/turntide-software-system/serve.mts"
    },
    "./union-media-origin": {
      "types": "./src/turntide-software-system/union-media-origin.mts",
      "import": "./src/turntide-software-system/union-media-origin.mts"
    },
    "./serve-union-media-origin": {
      "types": "./src/turntide-software-system/serve-union-media-origin.mts",
      "import": "./src/turntide-software-system/serve-union-media-origin.mts"
    },
    "./package.json": "./package.json",
    "./dist/turntide-software-system/discord.mjs": "./src/turntide-software-system/discord.mts"
  },
  "dependencies": {
    "@red-cup-engineering/ni-services-section": "0.1.2",
    "@napi-rs/canvas": "1.0.6",
    "@red-cup-engineering/a2a-agent-card-discovery-service": "1.0.13",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.10",
    "@red-cup-engineering/inference-work-lot-service": "4.2.8",
    "@red-cup-engineering/relation-model-notation-typing": "0.0.2",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.8",
    "@causeway-services/turntide-steward-inference-procurement-service": "1.0.0",
    "@causeway-services/turntide-union-media-syndication-service": "1.0.0",
    "@causeway-services/turntide-witness-journal-binding-service": "1.0.1",
    "@red-cup-engineering/witness-journal-document-service": "1.0.1",
    "@red-cup-engineering/settlement-record-store-service": "1.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
