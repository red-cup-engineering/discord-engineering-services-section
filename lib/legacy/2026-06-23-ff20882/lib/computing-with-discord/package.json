{
  "name": "@emsenn/computing-with-discord",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Computing with Discord — agentic operation of a Discord server by any OpenAI-compatible endpoint. A thin Discord transport (REST + Gateway, the only place the bot token and sockets enter), a pure operation vocabulary projected as agent tool definitions, a tool-executing agentic run loop built on @emsenn/computing-with-openai-agents and the @emsenn/computing-with-llm-agents/running carrier, and an autonomous server-tending pulse that lets an agent operate a guild on its own — creating channels, roles, threads, and webhook personas (new bots) as the server's goals require. Discord entities mount into the same @emsenn/relating meme topology as the agents that operate them.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp/test-dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/scripts/agent.mjs dist/scripts/ops.mjs",
    "prepack": "pnpm run rebuild",
    "rebuild": "pnpm run clean && pnpm run build"
  },
  "bin": {
    "discord-agent": "./dist/scripts/agent.mjs",
    "discord-ops": "./dist/scripts/ops.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./holography": {
      "types": "./dist/holography.d.mts",
      "import": "./dist/holography.mjs"
    },
    "./transport": {
      "types": "./dist/transport.d.mts",
      "import": "./dist/transport.mjs"
    },
    "./gateway": {
      "types": "./dist/gateway.d.mts",
      "import": "./dist/gateway.mjs"
    },
    "./operations": {
      "types": "./dist/operations.d.mts",
      "import": "./dist/operations.mjs"
    },
    "./context": {
      "types": "./dist/context.d.mts",
      "import": "./dist/context.mjs"
    },
    "./capital": {
      "types": "./dist/capital.d.mts",
      "import": "./dist/capital.mjs"
    },
    "./witnessing": {
      "types": "./dist/witnessing.d.mts",
      "import": "./dist/witnessing.mjs"
    },
    "./enclosure": {
      "types": "./dist/enclosure.d.mts",
      "import": "./dist/enclosure.mjs"
    },
    "./policy": {
      "types": "./dist/policy.d.mts",
      "import": "./dist/policy.mjs"
    },
    "./dispatch": {
      "types": "./dist/dispatch.d.mts",
      "import": "./dist/dispatch.mjs"
    },
    "./topology": {
      "types": "./dist/topology.d.mts",
      "import": "./dist/topology.mjs"
    },
    "./loop": {
      "types": "./dist/loop.d.mts",
      "import": "./dist/loop.mjs"
    },
    "./tending": {
      "types": "./dist/tending.d.mts",
      "import": "./dist/tending.mjs"
    },
    "./scripts/agent": {
      "types": "./dist/scripts/agent.d.mts",
      "import": "./dist/scripts/agent.mjs"
    },
    "./scripts/ops": {
      "types": "./dist/scripts/ops.d.mts",
      "import": "./dist/scripts/ops.mjs"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@emsenn/animating": "workspace:*",
    "@emsenn/organizing-with-agents": "workspace:*",
    "@emsenn/computing-with-llm-agents": "workspace:*",
    "@emsenn/computing-with-openai-agents": "workspace:*",
    "@emsenn/relating": "workspace:*",
    "@sinclair/typebox": "^0.34.41"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "sideEffects": false
}
